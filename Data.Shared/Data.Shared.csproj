<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Cerebellum.NetBlocks" Version="10.3.0" />
      <PackageReference Include="Cerebellum.NetBlocks.Models" Version="10.3.0" />
    </ItemGroup>

  <PropertyGroup>
    <PackageId>Cerebellum.BlazorBlocks.Data</PackageId>
    <Version>10.3.1</Version>
    <Authors>Daniel Harvey</Authors>
    <Company>Cerebellum Softworks</Company>
    <Description>EF Core data layer for Cerebellum.NetBlocks-based applications. Provides base DbContext classes, entity models, and repository abstractions to wire up persistence with minimal boilerplate.</Description>
    <PackageTags>blazor;aspnetcore;dotnet;cerebellum;netblocks;ef-core;data;repository</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/daniel-c-harvey/BlazorBlocks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daniel-c-harvey/BlazorBlocks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
      <!-- Intentional: DbExceptionClassifier is Postgres-specific (SqlState/ConstraintName).
           See SkipperHaven/PLAN.md "Error Propagation Architecture — Where translation happens". -->
      <PackageReference Include="Npgsql" Version="10.0.2" />
    </ItemGroup>


  <ItemGroup>
    <None Include="..\csw-brain-4-favicon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
